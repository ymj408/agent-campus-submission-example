      "title": "差旅报销制度（总部/华东区）",
      "version": "2.0",
      "effective_date": "2026-01-01",
      "updated_at": "2026-01-01",
      "status": "active",
      "scope_terms": ["总部", "华东"],
      "summary": "总部及华东区员工差旅报销的适用范围、申请期限与凭证要求。",
      "faq_questions": ["报销期限多久", "出差回来多久内要报销", "总部报销要几天"],
      "sections": [
        {
          "id": "S1",
          "title": "适用范围",
          "text": "本制度适用于总部及华东区员工的国内差旅报销。"
        },
        {
          "id": "S2",
          "title": "报销期限",
          "text": "员工应在差旅结束后 30 个自然日内提交报销申请，逾期需说明原因。"
        },
        {
          "id": "S3",
          "title": "提交方式",
          "text": "报销申请统一在财务系统提交，并附发票、行程单和审批记录。"
        }
      ],
      "facts": {
        "reimbursement_deadline_days": {
          "label": "报销期限",
          "value": 30,
          "unit": "天",
          "section_id": "S2"
        }
      }
    },
